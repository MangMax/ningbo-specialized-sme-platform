# 环境变量占位(票 18)。**真实值不要提交** —— `.env` 与 `.env.*` 已在 .gitignore 里。
# 复制成 `.env` 再填:`cp .env.example .env`

# ── MCP 写入 tool 的鉴权 token(票 18)────────────────────────────────────
# 只影响**写入** tool:`save_ocr_result` / `set_file_category` / `save_parse_result`
# (票 18)与 `save_roster_batch`(RL-11 的名录统一写入)。
# **留空 = 写入整体关闭**(只读 tool 照常可用,含只读预检 `preflight_roster_batch`)。设了之后,写入调用必须带
#   Authorization: Bearer <这个值>
# (也接受 `X-MCP-Token: <这个值>`,或不带 `Bearer` 前缀的裸 token)。
#
# 生成一个:`openssl rand -hex 32`
# 在 `pnpm dev` 时也可以临时给:`NUXT_MCP_TOKEN=$(openssl rand -hex 32) pnpm dev`
#
# ⚠️ MCP 是**代理的入口**,只读 tool 不鉴权(本地开发可只绑 127.0.0.1)。
NUXT_MCP_TOKEN=

# ── HTTP 能力面的鉴权 token(票 19)──────────────────────────────────────
# 管这几个写口:`POST /api/jobs`(提交任务)、`DELETE /api/jobs/:id`(取消任务),
# 以及 RL-11 的名录统一写入 `POST /api/roster/import/preflight` 与
# `POST /api/roster/import/commit`(预检 / 提交,单批事务 + 幂等键)。
# **留空 = 上述写口整体关闭**(只读接口 `/api/jobs`、`/api/records`、`/api/platform/*` 等照常可用)。
# 设置之后,这些接口必须带
#   Authorization: Bearer <这个值>
# (也接受 `X-API-Token: <这个值>`,或不带 `Bearer` 前缀的裸 token)。
#
# 与 `NUXT_MCP_TOKEN` **是两把独立的钥匙**(可以各自吊销)。想让 MCP 与 HTTP 共用
# 一个值,把两个变量设成同一个即可。
#
# ⚠️ **Nitro 内建的 OpenAPI 端点(`/_openapi.json` / `/_scalar`)只在开发环境注册**
# (nuxt.config.ts 的 `nitro.openAPI` 没设 `production`)。生产构建下它们返回 404,
# 这是有意的默认 —— spec 会把整张接口面摊开。若确实要在生产暴露,必须同时
# (1) 设 `nitro.openAPI.production`、(2) 自己在网关/反代上加一道鉴权。
NUXT_API_TOKEN=

# ── 页面复核写入口(#108,过渡部署能力)────────────────────────────────────
# 日常复核表单不再让业务人员填写写入凭证、操作人、规则版本。只有**同时**满足:
#   1) NUXT_API_TOKEN 非空;2) 显式设置 NUXT_BROWSER_REVIEW_ENABLED=true
# 才允许同源页面调用 POST /api/roster/evidence-review/browser-commands。
# **默认 false**;关闭时同源请求同样被拒绝,不是“同源即放行”。
#
# 这是“允许该应用的页面进行人工复核”的部署能力,**不是登录、会话或 RBAC**,
# 也不识别操作人。页面不会拿到 token,不写 cookie/localStorage。真实权限体系见 #127。
# 仅预览/受控环境可开启;生产默认不动。
# NUXT_BROWSER_REVIEW_ENABLED=true

# ── 工信部平台会话凭据(RL-03 的平台接口适配)────────────────────────────
# 只有**真的联网查平台**时才需要;用已取回的原始响应离线解析、或只读库内证据
# (`GET /api/platform/queries`)都不需要它。
#
# 谁用它:`POST /api/jobs {kind:"reconcile"}` 与 `node scripts/reconcile-live.mjs`
# (批量平台核查:实查两接口 → 落证据 → 判差异原因 → 统一 API 写回)。
# 这两个入口**拿不到凭据时直接明确失败、不写任何结果** —— 不产出一片「未查询」的假证据,
# 因为那会把「没查」冒充成「平台没有记录」。适配层本身(`queryAllRdjb`)不发请求,
# 四次查询记 `failed`(未查询 ≠ 无记录)。
#
# 取值:浏览器登录 https://zjtx.miit.gov.cn/zxqy/ → F12 Network → 任意接口请求 →
# Request Headers → Cookie。**环境凭据不进仓库、不进日志**;`.env` 已在 .gitignore 里,
# 仓库里只有本文件的**占位名**。生产上由父协调者在已登录会话中代取响应、落地为证据文件。
# 数据库保存的 Cookie 优先于下列环境回退；清除页面值不会修改环境变量。
MIIT_COOKIE=

# ── 在线 OCR(PaddleOCR API,票 14 的**通路 a**)──────────────────────────
# 只被 `POST /api/jobs {kind:"ocr"}` 用到。**上传通路(b)与页图渲染不需要它**,
# 所以留空不影响任何不需要联网的功能 —— 提交 ocr 任务时才会明确报「没配」。
#
# 这颗 token 与你的 MCP 配置(`uvx --from paddleocr-mcp paddleocr_mcp`)是**同一颗**;
# 直接放过 MCP 的那颗变量里也行(下面注释掉的那行),代码会自动回退到它。
#
#   NUXT_OCR_TOKEN=<aistudio access token>
#
# 也认下面这颗(与 MCP 配置同名):
# PADDLEOCR_MCP_AISTUDIO_ACCESS_TOKEN=
#
# 可选覆盖(自建网关 / 本地假服务 / 换模型):
# NUXT_OCR_BASE_URL=            # 默认 https://paddleocr.aistudio-app.com
# NUXT_OCR_MODEL=               # 默认 PaddleOCR-VL-1.6(文档解析,直接出 markdown)
# NUXT_OCR_POLL_TIMEOUT_MS=     # 轮询上限,默认 600000(10 分钟)
#
# ⚠️ **这颗 token 不入库、不进仓库**:`ocr_result` 的任何列与任务的 params/result
# 都不放它;`.env` 已在 .gitignore 里。仓库里只有本文件的**占位名**。
NUXT_OCR_TOKEN=

# ── 其余可选覆盖(见 nuxt.config.ts 的 runtimeConfig)─────────────────────
# NUXT_FILES_DIR=            # 文件库根,默认 <app>/files
# NUXT_INCOMING_DIR=         # tus 分片暂存目录,默认 <app>/.incoming
# NUXT_DB_PATH=              # SQLite 路径,默认 <cwd>/data/roster.db
# NUXT_LOG_DIR=              # 独立运行日志目录，默认 <cwd>/.runtime-logs；生产请挂独立持久卷
# NUXT_LOG_RETENTION_DAYS=7  # 首次初始化默认；已持久化策略优先
# NUXT_LOG_MAX_BYTES=536870912 # 512MiB，包含日志 SQLite 及 journal/WAL/SHM，主库最多1/3
# NUXT_BROWSER_LOGS_ENABLED=false # 显式页面能力开关，非用户身份；同时要求非空 API token
# NUXT_CURATED_PATH=         # 人工标注文件,默认 <app>/data/reconciliation-curated.json
# NUXT_TUS_ALLOWED_ORIGINS=  # tus 跨源白名单(逗号分隔)

# 后台 OCR token / 平台 Cookie 保存在上述 SQLite 的 service_credential 表。
# 数据库保存值优先于环境回退；数据库卷需持久化，完整备份包含敏感凭据。
