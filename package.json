{
  "name": "spztx-roster-board",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:studio": "drizzle-kit studio",
    "typecheck": "nuxt typecheck && tsc --noEmit -p .nuxt/tsconfig.server.json",
    "check:doctor": "vite-doctor .",
    "check:doctor:json": "vite-doctor . --format json",
    "check:doctor:structure": "vite-doctor . --analyses dead-code,graph,dupes,health",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:native-platform-boundary": "node scripts/verify-native-platform-boundary.mjs",
    "verify:module-boundaries": "node scripts/verify-module-boundaries.mjs",
    "verify:sql": "node scripts/sql-guard.mjs",
    "db:init": "node --env-file-if-exists=.env scripts/initialize-postgresql.mjs",
    "test:runtime": "vitest run --project runtime",
    "test:upgrade": "vitest run --project upgrade",
    "test:app": "vitest run --project app",
    "test:groups": "node scripts/business-test-groups.mjs inventory",
    "test:business": "node scripts/business-test-groups.mjs run"
  },
  "dependencies": {
