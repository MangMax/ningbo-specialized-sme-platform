    "@iconify-json/lucide": "^1.2.159",
    "@iconify-json/simple-icons": "^1.2.104",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.80.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxtjs/mcp-toolkit": "0.24.4",
    "@pinia/colada": "^1.4.9",
    "@pinia/colada-nuxt": "^1.2.1",
